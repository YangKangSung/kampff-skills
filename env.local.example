# copy to .env.local (gitignored via .env.*) then: source .env.local
# Prefer repo-relative paths so machines stay portable.

# Runtime scratch (inbox/queue/out) — required for real runs
export KAMPFF_DATA="${KAMPFF_DATA:-$PWD/kampff-data}"

# Optional durable wiki shelf (people/reports). Leave unset to skip promote.
# export KAMPFF_WIKI="$PWD/wiki"

# Optional: skills tree when spawning jobs from another cwd
# export KAMPFF_SKILLS="$PWD"

# activate venv each shell:
#   source .venv/Scripts/activate   # Windows git-bash
#   source .venv/bin/activate       # Linux/mac
