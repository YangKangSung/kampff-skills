{
  "batch_date": "2026-07-11",
  "viewer_id": "me",
  "people": [
    {
      "id": "me",
      "aliases": ["viewer"]
    },
    {
      "id": "target_id",
      "aliases": ["@their_x", "u/their_reddit"]
    }
  ],
  "targets": [
    {
      "url": "https://x.com/their_x",
      "platform": "x",
      "scope": "profile",
      "collect": ["post", "reply"],
      "match_people": ["target_id"],
      "auth_ref": "x_api",
      "query": { "username": "their_x", "limit": 100 }
    },
    {
      "url": "https://www.reddit.com/user/their_reddit/",
      "platform": "reddit",
      "scope": "user:their_reddit",
      "collect": ["post", "comment"],
      "match_people": ["target_id"],
      "auth_ref": "reddit_oauth",
      "query": { "username": "their_reddit", "limit": 100 }
    },
    {
      "url": "https://forum.example/u/alice",
      "platform": "generic",
      "scope": "profile",
      "collect": ["post", "comment"],
      "match_people": ["target_id"],
      "query": {
        "base_url": "https://forum.example",
        "handle": "alice",
        "profile_template": "{baseUrl}/u/{handle}",
        "post_template": "{baseUrl}/t/{id}"
      }
    }
  ],
  "meta": {
    "language": "en",
    "notes": "SNS + one custom URL target. No regional board presets."
  }
}
